                  ((function
                    | YAMLx.Value.Int (_, x) -> Ok (Int64.to_int x)
                    | _ ->
                        Error
                          (`Msg
                             "Was expecting 'int' but got a different type"))
                     x)
            | [] -> arg0 >>= ((fun arg0 -> Ok { age = arg0 }))
            | (_, x, _)::_ ->
                Error
                  (`Msg
                     ("Failed to find the case for: " ^ (YAMLx.Value.show x))) in
          loop xs (Error (`Msg "Didn't find the function for key: age"))
      | _ ->
          Error (`Msg "Failed building a key-value object expecting a list")
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
type x =
  {
  age: int
    [@of_yamlx
      function
      | YAMLx.Float (_, f) -> Ok (int_of_float (f +. 10.))
      | _ -> Error (`Msg "Expected a YAMLx.Float")]}[@@deriving yamlx]
include
  struct
    let x_to_yamlx (x : x) =
      YAMLx.Value.Map
        (YAMLx.zero_loc,
          (Stdlib.List.filter_map (fun x -> x)
             [Some
                (YAMLx.zero_loc,
                  (YAMLx.Value.String (YAMLx.zero_loc, "age")),
                  (((fun (x : int) ->
                       YAMLx.Value.Int (YAMLx.zero_loc, (Int64.of_int x))))
                     x.age))]))
    let x_of_yamlx =
      let (>>=) v f = match v with | Ok v -> f v | Error _ as e -> e[@@warning
                                                                    "-26"] in
      function
      | YAMLx.Value.Map (_, xs) ->
          let rec loop xs (arg0 as _state) =
            match xs with
            | (_, YAMLx.Value.String (_, "age"), x)::xs ->
                loop xs
                  ((function
                    | YAMLx.Float (_, f) -> Ok (int_of_float (f +. 10.))
                    | _ -> Error (`Msg "Expected a YAMLx.Float")) x)
            | [] -> arg0 >>= ((fun arg0 -> Ok { age = arg0 }))
            | (_, x, _)::_ ->
                Error
                  (`Msg
                     ("Failed to find the case for: " ^ (YAMLx.Value.show x))) in
          loop xs (Error (`Msg "Didn't find the function for key: age"))
      | _ ->
          Error (`Msg "Failed building a key-value object expecting a list")
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
